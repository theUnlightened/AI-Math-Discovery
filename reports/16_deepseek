import json
import sys
from collections import Counter, defaultdict

import networkx as nx


# -----------------------------
# Exact burning number
# -----------------------------

def burning_number(G):
    """Exact burning number of G. Relabels nodes internally."""
    G = nx.convert_node_labels_to_integers(G)
    n = len(G)
    if n == 0:
        return 0

    adj_mask = [0] * n
    for i in range(n):
        for j in G.neighbors(i):
            adj_mask[i] |= (1 << j)

    all_mask = (1 << n) - 1

    def can_burn(k):
        memo = {}

        def dfs(step, B):
            if B == all_mask:
                return True
            if step > k:
                return False
            key = (step, B)
            if key in memo:
                return memo[key]

            not_B = all_mask ^ B

            # Fire spreads from currently burning vertices only.
            NB = 0
            t = B
            while t:
                i_bit = t & -t
                i = i_bit.bit_length() - 1
                NB |= adj_mask[i]
                t ^= i_bit

            # New source must be unburned before selection.
            temp = not_B
            while temp:
                v_bit = temp & -temp
                v = v_bit.bit_length() - 1
                new_B = B | NB | v_bit
                if dfs(step + 1, new_B):
                    memo[key] = True
                    return True
                temp ^= v_bit

            memo[key] = False
            return False

        return dfs(1, 0)

    for k in range(1, n + 1):
        if can_burn(k):
            return k
    return n


def find_burning_sequence(G, k):
    """Return a valid burning sequence of length k, or None."""
    G = nx.convert_node_labels_to_integers(G)
    n = len(G)
    if n == 0:
        return []

    adj_mask = [0] * n
    for i in range(n):
        for j in G.neighbors(i):
            adj_mask[i] |= (1 << j)

    all_mask = (1 << n) - 1

    def dfs(step, B, seq):
        if B == all_mask:
            return seq
        if step > k:
            return None

        not_B = all_mask ^ B
        NB = 0
        t = B
        while t:
            i_bit = t & -t
            i = i_bit.bit_length() - 1
            NB |= adj_mask[i]
            t ^= i_bit

        temp = not_B
        while temp:
            v_bit = temp & -temp
            v = v_bit.bit_length() - 1
            new_B = B | NB | v_bit
            res = dfs(step + 1, new_B, seq + [v])
            if res is not None:
                return res
            temp ^= v_bit
        return None

    return dfs(1, 0, [])


# -----------------------------
# Suppress degree-2 vertices
# -----------------------------

def suppress_degree2(G):
    """Suppress all degree-2 vertices. Labels are preserved."""
    H = G.copy()
    changed = True
    while changed:
        changed = False
        for v in list(H.nodes()):
            if H.degree(v) == 2:
                neighbors = list(H.neighbors(v))
                if len(neighbors) == 2:
                    u, w = neighbors
                    H.remove_node(v)
                    if not H.has_edge(u, w):
                        H.add_edge(u, w)
                    changed = True
                    break
    return H


def subdivision_lengths_edges(T, H):
    """For each edge of H, return (u, v, s_e) where s_e is the number of
    degree-2 vertices inserted on the corresponding path in T."""
    data = []
    for u, v in H.edges():
        path = nx.shortest_path(T, u, v)
        s = len(path) - 2
        data.append((u, v, s))
    return data


# -----------------------------
# Validation
# -----------------------------

def validate():
    print("Validation tests:")

    for n in range(1, 13):
        P = nx.path_graph(n)
        b = burning_number(P)
        expected = int(n ** 0.5)
        if expected * expected < n:
            expected += 1
        ok = (b == expected)
        print(f"P_{n}: b={b}, expected={expected}, ok={ok}")
        if not ok:
            print("Validation failed on paths.")
            sys.exit(1)

    for m in range(2, 7):
        K = nx.star_graph(m)
        b = burning_number(K)
        ok = (b == 2)
        print(f"K_{{1,{m}}}: b={b}, expected=2, ok={ok}")
        if not ok:
            print("Validation failed on stars.")
            sys.exit(1)

    print("Validation passed.\n")


# -----------------------------
# Profiling a single tree
# -----------------------------

def profile_tree(T, b):
    T_int = nx.convert_node_labels_to_integers(T)

    deg_seq = sorted([d for _, d in T_int.degree()], reverse=True)
    leaves = sum(1 for d in deg_seq if d == 1)
    max_deg = max(deg_seq) if deg_seq else 0
    deg_counts = Counter(deg_seq)

    diameter = nx.diameter(T_int)
    radius = nx.radius(T_int)
    centers = sorted(nx.center(T_int))

    # Suppress degree-2 vertices. H keeps original labels from T_int.
    H = suppress_degree2(T_int)

    # Compute edge-associated subdivision data using original labels.
    sub_edges = subdivision_lengths_edges(T_int, H)
    sum_s = sum(s for _, _, s in sub_edges)
    max_s = max((s for _, _, s in sub_edges), default=0)
    num_sub_edges = sum(1 for _, _, s in sub_edges if s > 0)

    # Relabel core only after subdivision data are computed.
    H_int = nx.convert_node_labels_to_integers(H)

    bH = burning_number(H_int)
    delta_b = b - bH

    profile = {
        "b": b,
        "degree_sequence": deg_seq,
        "leaves": leaves,
        "max_degree": max_deg,
        "degree_counts": {int(k): int(v) for k, v in deg_counts.items()},
        "diameter": diameter,
        "radius": radius,
        "centers": centers,
        "core_edges": [list(e) for e in H_int.edges()],
        "core_degree_sequence": sorted([d for _, d in H_int.degree()], reverse=True),
        "core_leaves": sum(1 for _, d in H_int.degree() if d == 1),
        "core_max_degree": max([d for _, d in H_int.degree()], default=0),
        "core_diameter": nx.diameter(H_int),
        "core_radius": nx.radius(H_int),
        "core_centers": sorted(nx.center(H_int)),
        "b_H": bH,
        "delta_b": delta_b,
        "subdivision_edges": [[u, v, s] for u, v, s in sub_edges],
        "subdivision_sum": sum_s,
        "max_subdivision_length": max_s,
        "num_subdivided_edges": num_sub_edges,
    }

    if b == 4:
        profile["burning_sequence"] = find_burning_sequence(T_int, 4)

    return profile, H_int, H


# -----------------------------
# Canonical subdivision pattern modulo Aut(H)
# -----------------------------

def canonical_subdivision_pattern(H_rep, weight_dict):
    """
    H_rep: graph with vertices 0..n-1
    weight_dict: dict mapping (min(u,v), max(u,v)) -> weight
    Returns canonical tuple of weights under Aut(H_rep).
    """
    edges = sorted(H_rep.edges())
    edge_index = {e: i for i, e in enumerate(edges)}
    m = len(edges)

    w = [0] * m
    for e in edges:
        u, v = e
        key = (min(u, v), max(u, v))
        w[edge_index[e]] = weight_dict.get(key, 0)

    GM = nx.algorithms.isomorphism.GraphMatcher(H_rep, H_rep)
    best = None
    for phi in GM.isomorphisms_iter():
        w_phi = [0] * m
        for e in edges:
            u, v = e
            new_u, new_v = phi[u], phi[v]
            new_e = (min(new_u, new_v), max(new_u, new_v))
            w_phi[edge_index[new_e]] = w[edge_index[e]]
        w_phi_tuple = tuple(w_phi)
        if best is None or w_phi_tuple < best:
            best = w_phi_tuple
    return best


# -----------------------------
# Core isomorphism classes
# -----------------------------

def classify_cores(cores):
    unique = []
    members = []
    deg_to_indices = defaultdict(list)

    for idx, H in enumerate(cores):
        deg = tuple(sorted([d for _, d in H.degree()], reverse=True))
        deg_to_indices[deg].append(idx)

    for deg, indices in deg_to_indices.items():
        reps = []
        for idx in indices:
            H = cores[idx]
            found = False
            for u_idx, rep in reps:
                if nx.is_isomorphic(H, rep):
                    members[u_idx].append(idx)
                    found = True
                    break
            if not found:
                unique.append(H)
                members.append([idx])
                reps.append((len(unique) - 1, H))

    return unique, members


# -----------------------------
# Aggregate statistics
# -----------------------------

def aggregate(profiles):
    stats = {}
    keys = [
        "degree_sequence", "leaves", "max_degree", "diameter", "radius",
        "b_H", "delta_b", "max_subdivision_length", "num_subdivided_edges",
    ]
    for key in keys:
        c = Counter()
        for p in profiles:
            val = p[key]
            if isinstance(val, list):
                val = tuple(val)
            c[val] += 1
        stats[key] = {str(k): v for k, v in c.items()}
    return stats


